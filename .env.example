# Скопируйте этот файл в .env и подставьте реальные значения.

# Обязателен. Сгенерировать новый:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# True только для локальной разработки. На боевом сервере — False.
DEBUG=False

# Через запятую, без пробелов.
ALLOWED_HOSTS=127.0.0.1

# Домены, с которых разрешена отправка форм (админка и т.д.), со схемой,
# через запятую, без пробелов. Нужен только там, где сайт открыт по HTTPS
# через nginx. Пример: https://example.com
CSRF_TRUSTED_ORIGINS=

# Домен сайта для ссылок в письмах, без слэша на конце.
SITE_URL=http://127.0.0.1:8000

# redis://redis:6379/0 — если запускаете через docker-compose (там есть сервис redis).
# redis://localhost:6379/0 — если Redis запущен локально, вне docker-compose.
CELERY_BROKER_URL=redis://localhost:6379/0

# Отдельная база Redis — не пересекается с брокером Celery.
REDIS_CACHE_URL=redis://localhost:6379/1

# Обязательны, без значений по умолчанию.
POSTGRES_DB=promo_draw
POSTGRES_USER=promo_draw
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# SMTP. При DEBUG=True не используется — письма идут в консоль.
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@promo-draw.local

# Срок в секундах, на который браузер запомнит, что сайт открывается
# только по HTTPS (HSTS). Не используется при DEBUG=True.
SECURE_HSTS_SECONDS=3600
